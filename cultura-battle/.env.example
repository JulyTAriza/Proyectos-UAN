# Puerto HTTP del backend
PORT=3000
# Contraseña para crear/administrar partidas (¡cámbiala!)
ADMIN_PASSWORD=cambia-esta-clave
# Orígenes permitidos (frontend). Usa * para permitir todos, o la URL de GitHub Pages:
# CLIENT_ORIGIN=https://TU_USUARIO.github.io
CLIENT_ORIGIN=*
# Ruta del archivo SQLite (por defecto data/cultura-battle.db)
# DB_FILE=/var/data/cultura-battle.db
